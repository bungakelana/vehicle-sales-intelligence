---
import { readData } from '../lib/site-data';
import Base from '../layouts/Base.astro';
import ChartCard from '../components/ChartCard.astro';
import Takeaways from '../components/Takeaways.astro';
const insights = readData('insights.json');
const fc = readData('forecast.json');
---
<Base title="Outlook & Rekomendasi" question="Bagaimana prospek 6 bulan ke depan, dan apa yang harus dilakukan?">
  <ChartCard id="forecast" title={insights.outlook[0]} subtitle={`${fc.model} · interval ${fc.interval} · MAPE holdout ${fc.mape ? Math.round(fc.mape * 100) : '–'}% pada ${fc.holdout_pred.length} bulan terakhir`} height={360} />
  <div class="grid gap-4 lg:grid-cols-5">
    <ChartCard id="clmap" class="lg:col-span-3" title="Segmentasi pasar kabupaten (K-Means)" subtitle="Fitur: unit, rata-rata diskon, % leasing, pertumbuhan 12 bulan" height={400} />
    <ChartCard id="clprof" class="lg:col-span-2" title="Profil tiap segmen" subtitle="Rata-rata per kabupaten dalam segmen" height={400} />
  </div>
  <section aria-labelledby="rec-title">
    <h2 id="rec-title" class="text-lg font-semibold text-primary">Rekomendasi bisnis</h2>
    <div class="mt-3 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {insights.recommendations.map((r, i) => (
        <article class="card p-4">
          <div class="text-xs font-semibold" style="color: var(--highlight)">#{i + 1}</div>
          <h3 class="mt-1 font-semibold text-primary">{r.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">{r.body}</p>
        </article>
      ))}
    </div>
  </section>
  <Takeaways page="outlook" />
</Base>

<script>
  import { load, toObjects } from '../lib/data';
  import { axis, categorical, chart, echarts, table, tokens } from '../lib/echarts';
  import { num, num1, pct, ym } from '../lib/format';

  async function main() {
    const [fc, cl, gj] = await Promise.all([load('data/forecast.json'), load('data/clusters.json'), load('geo/riau_kabupaten.geojson')]);
    echarts.registerMap('riau', gj);

    chart('forecast', () => {
      const t = tokens();
      const months = [...fc.actual.map((r: any[]) => r[0]), ...fc.forecast.map((r: any[]) => r[0])];
      const nA = fc.actual.length;
      const actual = [...fc.actual.map((r: any[]) => r[1]), ...fc.forecast.map(() => null)];
      const hold = new Map(fc.holdout_pred.map((r: any[]) => [r[0], r[1]]));
      const fitted = months.map((m) => hold.get(m) ?? null);
      const mean = months.map((m, i) => (i === nA - 1 ? actual[i] : fc.forecast.find((r: any[]) => r[0] === m)?.[1] ?? null));
      const lo = months.map((m) => fc.forecast.find((r: any[]) => r[0] === m)?.[2] ?? null);
      const band = months.map((m) => { const r = fc.forecast.find((x: any[]) => x[0] === m); return r ? +(r[3] - r[2]).toFixed(1) : null; });
      table('forecast', ['Bulan', 'Forecast', 'Batas bawah', 'Batas atas'], fc.forecast.map((r: any[]) => [r[0], num1(r[1]), num1(r[2]), num1(r[3])]));
      return {
        tooltip: { trigger: 'axis', formatter: (ps: any[]) => `${ps[0].axisValue}<br/>` + ps.filter((p) => p.value != null && p.seriesName !== 'band' && p.seriesName !== 'lo').map((p) => `${p.marker}${p.seriesName}: ${num1(p.value)}`).join('<br/>') },
        legend: { data: ['Aktual', 'Prediksi holdout', 'Forecast'], right: 0 },
        xAxis: { type: 'category', data: months.map(ym), boundaryGap: false, ...axis({ splitLine: { show: false } }) },
        yAxis: { type: 'value', name: 'Unit', ...axis() },
        series: [
          { name: 'lo', type: 'line', stack: 'ci', data: lo, symbol: 'none', lineStyle: { opacity: 0 } },
          { name: 'band', type: 'line', stack: 'ci', data: band, symbol: 'none', lineStyle: { opacity: 0 }, areaStyle: { color: t.highlight, opacity: 0.18 } },
          { name: 'Aktual', type: 'line', data: actual, symbolSize: 4, lineStyle: { color: t.accent, width: 2 }, itemStyle: { color: t.accent } },
          { name: 'Prediksi holdout', type: 'line', data: fitted, symbol: 'none', lineStyle: { color: t.muted, type: 'dotted' }, itemStyle: { color: t.muted } },
          { name: 'Forecast', type: 'line', data: mean, symbolSize: 5, lineStyle: { color: t.highlight, width: 2, type: 'dashed' }, itemStyle: { color: t.highlight } },
        ],
      };
    });

    const k = toObjects<any>(cl.kabupaten);
    const labels = [...new Set(k.map((r) => r.cluster_label))].sort((a, b) => (a === 'Data terbatas' ? 1 : b === 'Data terbatas' ? -1 : a.localeCompare(b)));
    const colorOf = (l: string) => (l === 'Data terbatas' ? tokens().grey : categorical()[labels.indexOf(l) % 6]);

    chart('clmap', () => {
      const t = tokens();
      const byGeo = new Map<string, any>();
      k.filter((r) => r.geo_name).sort((a, b) => b.units - a.units).forEach((r) => !byGeo.has(r.geo_name) && byGeo.set(r.geo_name, r));
      table('clmap', ['Kabupaten', 'Segmen', 'Unit', 'Avg diskon', '% Leasing', 'Growth 12 bln'], k.map((r) => [r.kabupaten_std, r.cluster_label, r.units, pct(r.avg_discount_pct), pct(r.pct_leasing, 0), pct(r.growth, 0)]), 2);
      return {
        tooltip: { trigger: 'item', formatter: (p: any) => { const r = byGeo.get(p.name); return r ? `<b>${p.name}</b> · ${r.cluster_label}<br/>${r.units} unit · diskon ${pct(r.avg_discount_pct)} · leasing ${pct(r.pct_leasing, 0)}` : p.name; } },
        legend: { show: false },
        series: [{
          type: 'map', map: 'riau', roam: false, layoutCenter: ['50%', '50%'], layoutSize: '100%',
          itemStyle: { borderColor: t.surface, borderWidth: 1, areaColor: t.grey },
          label: { show: true, fontSize: 9, color: t.text },
          emphasis: { label: { color: t.text }, itemStyle: { areaColor: t.highlight } },
          data: gj.features.map((f: any) => { const r = byGeo.get(f.properties.name); return { name: f.properties.name, value: r?.units ?? 0, itemStyle: { areaColor: r ? colorOf(r.cluster_label) : t.grey } }; }),
        }],
      };
    });

    chart('clprof', () => {
      const t = tokens();
      const p = toObjects<any>(cl.profiles).filter((r) => r.cluster_label !== 'Data terbatas');
      table('clprof', ['Segmen', 'Jumlah kab.', 'Unit rata-rata', 'Avg diskon', '% Leasing', 'Growth'], p.map((r) => [r.cluster_label, r.n, num(r.units), pct(r.avg_discount_pct), pct(r.pct_leasing, 0), pct(r.growth, 0)]));
      return {
        tooltip: { trigger: 'axis' },
        legend: { top: 0, type: 'plain', textStyle: { color: t.muted, fontSize: 10 }, itemGap: 8 },
        grid: { left: 8, right: 16, top: 56, bottom: 8, containLabel: true },
        xAxis: { type: 'category', data: ['Unit (idx)', 'Diskon (idx)', 'Leasing (idx)', 'Growth (idx)'], ...axis({ splitLine: { show: false }, axisLabel: { color: t.muted, fontSize: 10 } }) },
        yAxis: { type: 'value', ...axis() },
        series: p.map((r) => {
          const avg = (key: string) => p.reduce((s, x) => s + x[key], 0) / p.length;
          const idx = (key: string) => +(((r[key] + (key === 'growth' ? 1 : 0)) / (avg(key) + (key === 'growth' ? 1 : 0))) * 100).toFixed(0);
          return { name: `${r.cluster_label} (${r.n})`, type: 'bar', barMaxWidth: 14, itemStyle: { color: colorOf(r.cluster_label) },
            data: [idx('units'), idx('avg_discount_pct'), idx('pct_leasing'), idx('growth')] };
        }),
      };
    });
  }
  main();
</script>
